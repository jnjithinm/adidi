
{
  "extends": "@tsconfig/react-native/tsconfig.json",
  "compilerOptions": {
    "baseUrl": "./src",
    "rootDir": ".",
    "paths": {
      "*": ["*", "src/*"],
      "api/*":["./api/*"],
      "assets/*":["./assets/*"],
      "components/*": ["./components/*"],
      "constants/*": ["./constants/*"],
      "navigation/*":["./navigation/*"],
      "screens/*": ["./screens/*"],
      "utils/*": ["./utils/*"],
    },
    "module": "esnext",
    "target": "esnext",
    "lib": ["esnext", "dom",  "es5", "es6", "dom.iterable"],
    "esModuleInterop": true,
    "jsx": "react-native",
    "strict": true,
    "moduleResolution": "node",
    "allowSyntheticDefaultImports": true,
    "noImplicitReturns": true,
    "resolveJsonModule": true,
    "noImplicitAny": false,
    "noImplicitThis": true,
    "noUnusedLocals": true,
    "sourceMap": true,
    "experimentalDecorators": true,
    "emitDecoratorMetadata": true,
    "skipLibCheck": true
  },
  "exclude": ["node_modules", "babel.config.js", "metro.config.js", "jest.config.js", "setupTests.ts", "testSetup.ts"]
}
